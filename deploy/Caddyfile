{$SIMMER_DOMAIN} {
  encode zstd gzip

  @collector {
    method POST
    path /api/ingest /api/ai-token-events /api/hardware-samples /api/device-heartbeat
  }
  handle @collector {
    reverse_proxy simmer:8788
  }

  handle {
    basic_auth {
      {$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
    }
    reverse_proxy simmer:8788
  }
}

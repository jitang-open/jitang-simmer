# 仅填写域名，不要带 https://
SIMMER_DOMAIN=simmer.example.com

# 采集端上报专用 Bearer Token。可用 openssl rand -hex 32 生成。
SIMMER_TOKEN=replace-with-a-long-random-token

# 浏览器访问面板时的 HTTP Basic Auth。
DASHBOARD_USER=jitang

# 生成命令：docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '你的强密码'
DASHBOARD_PASSWORD_HASH='$2a$14$replace_with_caddy_bcrypt_hash'
